# ──────────────────────────────────────
# D. Payments
# ──────────────────────────────────────

### Initialize Payment
POST {{baseUrl}}/api/v1/payments/initialize
x-user-id: {{buyerId}}
x-user-email: jane.buyer@yopmail.com
Content-Type: {{contentType}}

{
  "amount": 25000,
  "booking_id": "{{bookingId}}",
  "metadata": {
    "service": "plumbing",
    "provider_id": "{{providerId}}"
  },
  "callback_url": "http://localhost:3000/api/v1/payments/callback"
}

> {%
  client.test("Payment initialized", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(response.body.data.reference, "Expected payment reference");
    client.assert(response.body.data.authorization_url, "Expected authorization_url (mock)");
    client.global.set("paymentRef", response.body.data.reference);
    console.log("Payment reference: " + response.body.data.reference);
  });
%}

### Verify Payment
POST {{baseUrl}}/api/v1/payments/verify
x-user-id: {{buyerId}}
x-user-email: jane.buyer@yopmail.com
Content-Type: {{contentType}}

{
  "reference": "{{paymentRef}}"
}

> {%
  client.test("Payment verified", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    console.log("Payment status: " + response.body.data.status);
  });
%}
