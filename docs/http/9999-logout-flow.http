# ──────────────────────────────────────
# Verify tokens are invalidated
# ──────────────────────────────────────

### Confirm Buyer Token Invalidated
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{buyerAuthToken}}
Accept: {{contentType}}

> {%
  client.test("Buyer token rejected after logout", function() {
    client.assert(response.status === 401, "Expected 401 after logout, got " + response.status);
  });
%}

### Confirm Provider Token Invalidated
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{providerAuthToken}}
Accept: {{contentType}}

> {%
  client.test("Provider token rejected after logout", function() {
    client.assert(response.status === 401, "Expected 401 after logout, got " + response.status);
  });
%}

