### Adverts, Referrals, Safety, Saved Searches, Support & Contact Updates Flow
### Prerequisites:
###   1. Run 01-auth-and-otp-flow.http — set buyerAuthToken, buyerId
###   2. Run 02-provider-flow.http — set providerAuthToken, providerId
###   3. Run 03-seller-flow.http — set sellerAuthToken, sellerId

@js { client.global.set("baseUrl", "http://localhost:3000"); }

@contentType = application/json

# ──────────────────────────────────────
# A. Adverts
# ──────────────────────────────────────

### List Active Adverts (public-ish, needs user resolution)
GET {{baseUrl}}/api/v1/adverts
x-user-id: {{buyerId}}
x-user-role: buyer
Accept: {{contentType}}

> {%
  client.test("Adverts listed", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(Array.isArray(response.body.data), "Expected array of adverts");
  });
%}

### Submit Advert (as Seller)
POST {{baseUrl}}/api/v1/adverts
x-user-id: {{sellerId}}
x-user-role: seller
Content-Type: {{contentType}}

{
  "title": "Summer Mega Sale — 40% Off All Electronics!",
  "description": "Huge discounts on phones, laptops, TVs, and accessories. Limited time offer, first 100 orders get free delivery.",
  "image_url": "https://example.com/uploads/adverts/summer-sale-banner.png",
  "link": "https://distressnow.com/promo/summer-sale",
  "starts_at": "2026-09-20T00:00:00.000Z",
  "ends_at": "2026-10-20T23:59:59.000Z"
}

> {%
  client.test("Advert submitted", function() {
    client.assert(response.status === 201, "Expected 201, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(response.body.data.title.includes("Summer Mega Sale"), "Expected correct title");
    client.assert(response.body.data.status === "pending", "Expected status: pending (awaiting admin review)");
    client.global.set("advertId", response.body.data.id);
    console.log("Advert ID: " + response.body.data.id);
  });
%}

# ──────────────────────────────────────
# B. Referrals
# ──────────────────────────────────────

### Register Referral Code
POST {{baseUrl}}/api/v1/referrals
Authorization: Bearer {{buyerAuthToken}}
Content-Type: {{contentType}}

{
  "code": "JANE2026",
  "campaign": "back-to-school-2026",
  "metadata": {
    "source": "social_media",
    "platform": "instagram"
  }
}

> {%
  client.test("Referral code registered", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
  });
%}

### Record Attribution
POST {{baseUrl}}/api/v1/referrals/attribution
Authorization: Bearer {{buyerAuthToken}}
Content-Type: {{contentType}}

{
  "source": "instagram",
  "campaign": "back-to-school-2026",
  "event": "signup",
  "attribution_id": "attr-001",
  "metadata": {
    "post_id": "ig-post-12345",
    "story_views": 1500
  }
}

> {%
  client.test("Attribution recorded", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
  });
%}

# ──────────────────────────────────────
# C. Safety
# ──────────────────────────────────────

### Report a User
POST {{baseUrl}}/api/v1/safety
Authorization: Bearer {{buyerAuthToken}}
Content-Type: {{contentType}}

{
  "target_type": "user",
  "target_id": "{{providerId}}",
  "reason": "Suspicious behavior — asked for payment outside the platform",
  "details": "The provider asked me to send money to a personal bank account instead of using the in-app payment. This happened during chat conversation conv-buyer-provider-001."
}

> {%
  client.test("Safety report submitted", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
  });
%}

### Report a Listing
POST {{baseUrl}}/api/v1/safety
Authorization: Bearer {{providerAuthToken}}
Content-Type: {{contentType}}

{
  "target_type": "listing",
  "target_id": "{{listingId}}",
  "reason": "Listing appears to be counterfeit goods",
  "details": "The product images match known counterfeit branding. The price is unrealistically low for the claimed brand."
}

> {%
  client.test("Listing safety report submitted", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
  });
%}

# ──────────────────────────────────────
# D. Saved Searches
# ──────────────────────────────────────

### List Saved Searches
GET {{baseUrl}}/api/v1/saved-searches
Authorization: Bearer {{buyerAuthToken}}
Accept: {{contentType}}

> {%
  client.test("Saved searches listed", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(Array.isArray(response.body.data), "Expected array of saved searches");
  });
%}

### Create Saved Search
POST {{baseUrl}}/api/v1/saved-searches
Authorization: Bearer {{buyerAuthToken}}
Content-Type: {{contentType}}

{
  "name": "Affordable Phones in Lagos",
  "filters": {
    "q": "phone",
    "category": "electronics",
    "state": "lagos",
    "min_price": 10000,
    "max_price": 100000,
    "condition": "used",
    "sort": "price_asc"
  }
}

> {%
  client.test("Saved search created", function() {
    client.assert(response.status === 201, "Expected 201, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(response.body.data.name === "Affordable Phones in Lagos", "Expected correct name");
    client.global.set("savedSearchId", response.body.data.id);
    console.log("Saved search ID: " + response.body.data.id);
  });
%}

### Create Another Saved Search
POST {{baseUrl}}/api/v1/saved-searches
Authorization: Bearer {{buyerAuthToken}}
Content-Type: {{contentType}}

{
  "name": "Distress Deals — Electronics",
  "filters": {
    "category": "electronics",
    "distress": true,
    "sort": "newest"
  }
}

> {%
  client.test("Second saved search created", function() {
    client.assert(response.status === 201, "Expected 201, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
  });
%}

### Delete Saved Search
DELETE {{baseUrl}}/api/v1/saved-searches/{{savedSearchId}}
Authorization: Bearer {{buyerAuthToken}}

> {%
  client.test("Saved search deleted", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
  });
%}

# ──────────────────────────────────────
# E. Support Tickets
# ──────────────────────────────────────

### Create Support Ticket
POST {{baseUrl}}/api/v1/support/tickets
Authorization: Bearer {{buyerAuthToken}}
Content-Type: {{contentType}}

{
  "subject": "Payment not reflecting after successful transaction",
  "message": "I made a payment of ₦25,000 for booking #{{bookingId}} via Paystack. The payment was successful on Paystack's end but the booking still shows as unpaid. Transaction reference: {{paymentRef}}",
  "category": "payment",
  "priority": "high"
}

> {%
  client.test("Support ticket created", function() {
    client.assert(response.status === 201, "Expected 201, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(response.body.data.subject.includes("Payment"), "Expected correct subject");
    client.assert(response.body.data.status === "open", "Expected status: open");
    client.global.set("supportTicketId", response.body.data.id);
    console.log("Support ticket ID: " + response.body.data.id);
  });
%}

### List Support Tickets (as Buyer)
GET {{baseUrl}}/api/v1/support/tickets
Authorization: Bearer {{buyerAuthToken}}
Accept: {{contentType}}

> {%
  client.test("Support tickets listed", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(Array.isArray(response.body.data), "Expected array of tickets");
  });
%}

### Get Ticket Detail
GET {{baseUrl}}/api/v1/support/tickets/{{supportTicketId}}
Authorization: Bearer {{buyerAuthToken}}
Accept: {{contentType}}

> {%
  client.test("Ticket detail returned", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(response.body.data.subject.includes("Payment"), "Expected correct subject");
  });
%}

### Reply to Ticket
POST {{baseUrl}}/api/v1/support/tickets/{{supportTicketId}}/reply
Authorization: Bearer {{buyerAuthToken}}
Content-Type: {{contentType}}

{
  "message": "Additional info: I have a screenshot of the Paystack confirmation email showing the debit."
}

> {%
  client.test("Ticket reply sent", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
  });
%}

### Update Ticket Status
PATCH {{baseUrl}}/api/v1/support/tickets/{{supportTicketId}}/status
Authorization: Bearer {{buyerAuthToken}}
Content-Type: {{contentType}}

{
  "status": "closed"
}

> {%
  client.test("Ticket status updated", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(response.body.data.status === "closed", "Expected status: closed");
  });
%}

# ──────────────────────────────────────
# F. Provider Update Profile (direct, non-admin)
# ──────────────────────────────────────

### Update Provider Bio & Skills
PATCH {{baseUrl}}/api/v1/providers/{{providerId}}
Authorization: Bearer {{providerAuthToken}}
Content-Type: {{contentType}}

{
  "bio": "Certified master plumber with 12+ years of experience. Specializing in residential and commercial plumbing installations, repairs, and maintenance. Available for emergency calls.",
  "service_categories": ["plumbing", "electrical", "hvac"],
  "experience_years": 12,
  "price_range": "₦15,000 – ₦80,000",
  "response_time": "Within 30 minutes for emergencies",
  "availability": "immediate",
  "skills": [
    "pipe installation",
    "leak repair",
    "water heater installation",
    "drainage systems",
    "borehole maintenance",
    "electrical wiring",
    "AC installation and repair"
  ]
}

> {%
  client.test("Provider profile updated with expanded skills", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
  });
%}

# ──────────────────────────────────────
# G. Contact Updates (user requests change)
# ──────────────────────────────────────

### Submit Contact Update Request
POST {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{buyerAuthToken}}
Content-Type: {{contentType}}

{
  "phone": "+2348099999999",
  "whatsapp_number": "+2348099999999"
}

> {%
  client.test("Profile contact info updated", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    console.log("Updated phone: " + response.body.data.phone);
  });
%}

### Verify Updated Profile
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{buyerAuthToken}}
Accept: {{contentType}}

> {%
  client.test("Profile shows updated contact info", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.data.phone === "+2348099999999", "Expected updated phone");
  });
%}
