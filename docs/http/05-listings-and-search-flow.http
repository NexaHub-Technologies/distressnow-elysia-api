### Listings, Search & Catalog Flow
### Prerequisites:
###   1. Run 01-auth-and-otp-flow.http — set buyerAuthToken, buyerId
###   2. Run 03-seller-flow.http — set sellerAuthToken, sellerId, storeId

@js { client.global.set("baseUrl", "http://localhost:3000"); }

@contentType = application/json

# ──────────────────────────────────────
# A. Catalog (Public, No Auth)
# ──────────────────────────────────────

### List Categories
GET {{baseUrl}}/api/v1/catalog/categories
Accept: {{contentType}}

> {%
  client.test("Categories returned", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(Array.isArray(response.body.data), "Expected array of categories");
    if (response.body.data.length > 0) {
      client.global.set("firstCategoryId", response.body.data[0].id);
      console.log("First category: " + response.body.data[0].id);
    }
  });
%}

### List States
GET {{baseUrl}}/api/v1/catalog/locations/states
Accept: {{contentType}}

> {%
  client.test("States returned", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(Array.isArray(response.body.data), "Expected array of states");
    if (response.body.data.length > 0) {
      client.global.set("firstStateId", response.body.data[0].id);
      console.log("First state: " + response.body.data[0].id);
    }
  });
%}

