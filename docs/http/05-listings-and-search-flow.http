# ──────────────────────────────────────
# B. Create Listings
# ──────────────────────────────────────

### Create Regular Listing (as Seller)
POST {{baseUrl}}/api/v1/listings
Authorization: Bearer {{sellerAuthToken}}
Content-Type: {{contentType}}

{
  "title": "iPhone 15 Pro Max — 256GB, Space Black",
  "description": "Barely used iPhone 15 Pro Max in Space Black. 256GB storage, 100% battery health. Comes with original box, charger, and a Spigen case. No scratches or dents. Bought from authorized dealer 3 months ago.",
  "price": 850000,
  "condition": "like_new",
  "state": "lagos",
  "category": "electronics",
  "deal_type": "regular"
}

> {%
  client.test("Regular listing created", function() {
    client.assert(response.status === 201, "Expected 201, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(response.body.data.title.includes("iPhone"), "Expected correct title");
    client.assert(response.body.data.status === "pending", "Expected status: pending admin review");
    client.global.set("listingId", response.body.data.id);
    console.log("Listing ID: " + response.body.data.id);
  });
%}

### Create Distress Deal Listing (≥20% discount)
POST {{baseUrl}}/api/v1/listings
Authorization: Bearer {{sellerAuthToken}}
Content-Type: {{contentType}}

{
  "title": "🔥 DISTRESS: Samsung 65\" QLED 4K Smart TV — Must Go!",
  "description": "Moving abroad urgently! Selling my Samsung 65-inch QLED 4K Smart TV at a massive loss. Original price ₦1,200,000. Anti-sound bar included. Perfect working condition, wall mount bracket included.",
  "price": 900000,
  "discount_price": 700000,
  "condition": "like_new",
  "state": "lagos",
  "category": "electronics",
  "deal_type": "distress"
}

> {%
  client.test("Distress deal listing created", function() {
    client.assert(response.status === 201, "Expected 201, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(response.body.data.deal_type === "distress", "Expected deal_type: distress");
    client.global.set("distressListingId", response.body.data.id);
    console.log("Distress listing ID: " + response.body.data.id);
  });
%}

### Create Furniture Listing
POST {{baseUrl}}/api/v1/listings
Authorization: Bearer {{sellerAuthToken}}
Content-Type: {{contentType}}

{
  "title": "Solid Oak Dining Table — 6 Seater",
  "description": "Beautiful solid oak dining table, seats 6 comfortably. Minor surface scratches but structurally perfect. Perfect for a family home.",
  "price": 180000,
  "condition": "good",
  "state": "abuja",
  "category": "furniture",
  "deal_type": "regular"
}

> {%
  client.test("Furniture listing created", function() {
    client.assert(response.status === 201, "Expected 201, got " + response.status);
    client.global.set("furnitureListingId", response.body.data.id);
  });
%}

# ──────────────────────────────────────
# C. Upload Listing Images
# ──────────────────────────────────────

### Upload Listing Image
POST {{baseUrl}}/api/v1/media/upload
x-user-id: {{sellerId}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="dummy.png"
Content-Type: image/png

< ./docs/http/dummy.png
--WebAppBoundary
Content-Disposition: form-data; name="folder"

listings
--WebAppBoundary--

> {%
  client.test("Listing image uploaded", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(response.body.data.url, "Expected file URL");
    client.global.set("listingImageUrl", response.body.data.url);
    console.log("Image URL: " + response.body.data.url);
  });
%}

### Upload Second Listing Image
POST {{baseUrl}}/api/v1/media/upload
x-user-id: {{sellerId}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="dummy.png"
Content-Type: image/png

< ./docs/http/dummy.png
--WebAppBoundary
Content-Disposition: form-data; name="folder"

listings
--WebAppBoundary--

> {%
  client.test("Second listing image uploaded", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.global.set("listingImageUrl2", response.body.data.url);
  });
%}

# ──────────────────────────────────────
# D. Manage Listings
# ──────────────────────────────────────

### Get Listing Detail
GET {{baseUrl}}/api/v1/listings/{{listingId}}
Accept: {{contentType}}

> {%
  client.test("Listing detail returned", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(response.body.data.id === listingId, "Expected correct listing");
  });
%}

### Update Listing
PATCH {{baseUrl}}/api/v1/listings/{{listingId}}
Authorization: Bearer {{sellerAuthToken}}
Content-Type: {{contentType}}

{
  "title": "iPhone 15 Pro Max — 256GB, Space Black (Price Reduced!)",
  "price": 800000,
  "description": "Price reduced! Barely used iPhone 15 Pro Max in Space Black. 256GB storage, 100% battery health. Comes with original box, charger, and Spigen case."
}

> {%
  client.test("Listing updated", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(response.body.data.price === 800000, "Expected updated price");
  });
%}

### Promote Listing (Bump 5 Days)
POST {{baseUrl}}/api/v1/listings/{{listingId}}/promote
Authorization: Bearer {{sellerAuthToken}}
Content-Type: {{contentType}}

{
  "tier": "bump_5_days"
}

> {%
  client.test("Listing promotion initiated", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
  });
%}

