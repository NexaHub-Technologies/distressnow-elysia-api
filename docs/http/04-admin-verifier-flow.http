### Create Market
POST {{baseUrl}}/api/v1/admin/markets
x-user-id: {{adminId}}
x-user-role: admin
Content-Type: {{contentType}}

{
  "name": "Alaba International Market",
  "state_id": "lagos",
  "sublocation_id": "oshodi",
  "description": "West Africa's largest market for electronics, gadgets, and wholesale goods"
}

> {%
  client.test("Market created", function() {
    client.assert(response.status === 201, "Expected 201, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.global.set("marketId", response.body.data.id);
    console.log("Market ID: " + response.body.data.id);
  });
%}

### Update Market
PATCH {{baseUrl}}/api/v1/admin/markets/{{marketId}}
x-user-id: {{adminId}}
x-user-role: admin
Content-Type: {{contentType}}

{
