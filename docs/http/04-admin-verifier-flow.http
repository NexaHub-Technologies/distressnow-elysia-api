### Reject Listing (create a temp listing first, then reject)
POST {{baseUrl}}/api/v1/listings
Authorization: Bearer {{sellerAuthToken}}
Content-Type: {{contentType}}

{
  "title": "Suspicious Item — Will Be Rejected",
  "description": "This listing violates community guidelines and should be removed by admin.",
  "price": 500,
  "condition": "used",
  "state": "lagos",
  "category": "other"
}

> {%
  client.test("Temp listing created for rejection", function() {
    client.assert(response.status === 201, "Expected 201, got " + response.status);
    client.global.set("tempListingId", response.body.data.id);
  });
%}

### Reject the Temp Listing
PATCH {{baseUrl}}/api/v1/admin/listings/{{tempListingId}}/reject
x-user-id: {{adminId}}
x-user-role: admin
Content-Type: {{contentType}}

{
  "reason": "Listing violates community guidelines: prohibited item category"
}

> {%
  client.test("Listing rejected", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
  });
%}

