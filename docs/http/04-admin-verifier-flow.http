### Suspend User (suspend the buyer for testing)
POST {{baseUrl}}/api/v1/admin/users/{{buyerId}}/suspend
x-user-id: {{adminId}}
x-user-role: admin
Content-Type: {{contentType}}

{
  "reason": "Suspicious activity detected — multiple failed login attempts",
  "notes": "Automated suspension pending review"
}

> {%
  client.test("User suspended", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(response.body.data.suspended === true, "Expected suspended: true");
  });
%}

### Unsuspend User
POST {{baseUrl}}/api/v1/admin/users/{{buyerId}}/unsuspend
x-user-id: {{adminId}}
x-user-role: admin
Content-Type: {{contentType}}

{}

> {%
  client.test("User unsuspended", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(response.body.data.suspended === false, "Expected suspended: false");
  });
%}

### Assign Role (make shop manager an admin for testing, then revert)
POST {{baseUrl}}/api/v1/admin/users/{{shopManagerId}}/assign-role
x-user-id: {{adminId}}
x-user-role: admin
Content-Type: {{contentType}}

{
  "role": "admin"
}

> {%
  client.test("Role assigned", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(response.body.data.role === "admin", "Expected role: admin");
  });
%}

### Revert Role
POST {{baseUrl}}/api/v1/admin/users/{{shopManagerId}}/assign-role
x-user-id: {{adminId}}
x-user-role: admin
Content-Type: {{contentType}}

{
  "role": "shop_manager"
}

> {%
  client.test("Role reverted to shop_manager", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(response.body.data.role === "shop_manager", "Expected role: shop_manager");
  });
%}

