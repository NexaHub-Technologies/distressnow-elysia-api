### Admin & Verifier Flow
### Prerequisites:
###   1. Run 01-auth-and-otp-flow.http — create & verify buyer
###   2. Run 02-provider-flow.http — create provider (need providerId, applicationId from step 1)
###   3. Run 03-seller-flow.http — create seller (need sellerId, applicationId from step 1)
###   4. Set seeded IDs in http-client.env.json (adminId, verifierId, shopManagerId)
###
### NOTE: Admin module uses x-user-id + x-user-role headers (NOT JWT auth).
###       The auth token for admin login is set from step 9 of 02-provider-flow.http.

@js { client.global.set("baseUrl", "http://localhost:3000"); }

@contentType = application/json

# ──────────────────────────────────────
# A. Admin Authentication
# ──────────────────────────────────────

### Admin Login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: {{contentType}}

{
  "login": "distressnow09@gmail.com",
  "password": "18781875"
}

> {%
  client.test("Admin login returned 200", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(response.body.data.user.role === "admin", "Expected role: admin");
    client.global.set("adminAuthToken", response.body.data.token);
    client.global.set("adminId", response.body.data.user.id);
    console.log("Admin ID: " + response.body.data.user.id);
  });
%}

### Verifier Login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: {{contentType}}

{
  "login": "verifier@yopmail.com",
  "password": "18781875"
}

> {%
  client.test("Verifier login returned 200", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(response.body.data.user.role === "verifier", "Expected role: verifier");
    client.global.set("verifierAuthToken", response.body.data.token);
    client.global.set("verifierId", response.body.data.user.id);
    console.log("Verifier ID: " + response.body.data.user.id);
  });
%}

### Shop Manager Login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: {{contentType}}

{
  "login": "shop-manager@yopmail.com",
  "password": "18781875"
}

> {%
  client.test("Shop Manager login returned 200", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.global.set("shopManagerAuthToken", response.body.data.token);
    client.global.set("shopManagerId", response.body.data.user.id);
    console.log("Shop Manager ID: " + response.body.data.user.id);
  });
%}

# ──────────────────────────────────────
# B. Dashboard Stats
# ──────────────────────────────────────

### Admin Dashboard Stats
GET {{baseUrl}}/api/v1/admin/dashboard/stats
x-user-id: {{adminId}}
x-user-role: admin
Accept: {{contentType}}

> {%
  client.test("Dashboard stats returned", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(typeof response.body.data === "object", "Expected object of stats");
    console.log("Stats keys: " + Object.keys(response.body.data).join(", "));
  });
%}

# ──────────────────────────────────────
# C. KYC Management
# ──────────────────────────────────────

### List All KYC Submissions
GET {{baseUrl}}/api/v1/admin/kyc
x-user-id: {{adminId}}
x-user-role: admin
Accept: {{contentType}}

> {%
  client.test("KYC list returned", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(Array.isArray(response.body.data), "Expected array of KYC submissions");
  });
%}

### Approve Provider KYC (Level 1)
### Uses the KYC ID from 02-provider-flow.http — set kycId before running
PATCH {{baseUrl}}/api/v1/admin/kyc/{{kycId}}/approve
x-user-id: {{adminId}}
x-user-role: admin
Content-Type: {{contentType}}

{
  "notes": "NIN verified, documents match. Approved for provider application."
}

> {%
  client.test("Provider KYC approved", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
    client.assert(response.body.data.status === "approved", "Expected status: approved");
  });
%}

### Reject KYC (use a test submission or re-submit then reject)
### For demo: approve then re-submit at a higher level to test rejection flow
POST {{baseUrl}}/api/v1/kyc
Authorization: Bearer {{providerAuthToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="level"

2
--WebAppBoundary
Content-Disposition: form-data; name="cac_number"

RC12345678
--WebAppBoundary
Content-Disposition: form-data; name="smedan_number"

SMED987654
--WebAppBoundary
Content-Disposition: form-data; name="business_name"; filename="dummy.png"
Content-Type: image/png

< ./docs/http/dummy.png
--WebAppBoundary--

> {%
  client.test("Level 2 KYC submitted for rejection test", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.global.set("kycId2", response.body.data.id);
    console.log("KYC ID 2: " + response.body.data.id);
  });
%}

### Approve Level 2 KYC
PATCH {{baseUrl}}/api/v1/admin/kyc/{{kycId2}}/approve
x-user-id: {{adminId}}
x-user-role: admin
Content-Type: {{contentType}}

{
  "notes": "Business documents verified. Level 2 approved for seller application."
}

> {%
  client.test("Level 2 KYC approved", function() {
    client.assert(response.status === 200, "Expected 200, got " + response.status);
    client.assert(response.body.success === true, "Expected success: true");
  });
%}

