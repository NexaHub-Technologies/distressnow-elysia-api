# ─── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/distressnow

# ─── Auth ─────────────────────────────────────────────────────────────────
# HS256 secret for Elysia JWT (7-day expiry, mirrors Sanctum token lifetime)
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000

# ─── Mail (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=no-reply@distressnow.com

# ─── SMS OTP (Termii) ─────────────────────────────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=DistressNow
TERMII_BASE_URL=https://api.ng.termii.com

# ─── Media (Cloudinary) ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Payments (Paystack) ──────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ─── Push (Expo) ──────────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=
